# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Project-local virtualenv created by run.ps1 (includes .requirements-sha256)
.venv/
venv/

# Not a packaged project, but keep accidental build output out
build/
dist/
*.egg-info/

# No Node build in this project; kept for local tooling
node_modules/

# ---------------------------------------------------------- Runtime data
# Default data dir is %LOCALAPPDATA%\HomeworkReminder, but HMR_DATA_DIR may
# point inside the repo. Never commit the SQLite database or its WAL files.
*.db
*.db-*
*.sqlite
*.sqlite3
application.lock

# --------------------------------------------------- Local config, secrets
.env
.env.*
*.pem
*.key

# ------------------------------------------------- Verification artifacts
# pytest XML, browser-check logs, screenshots, .diff and backup trees.
# All generated by scripts/*_check.py; recreated on demand.
output/

# ------------------------------------------------------------------ Logs
*.log

# ------------------------------------- Excel lock files (opening examples)
~$*

# ------------------------------------------------------------ OS / editors
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
